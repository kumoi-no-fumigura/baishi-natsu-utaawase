 "poems": [
  {
   "seq": "1",
   "text": "ほとゝきす待あかしたる東雲に鳴ひとこゑは身にそしみける",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "郭公いかなる里に旅ねしてまたしのゝめに鳴て過らむ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "時鳥なきつる空を詠つゝ遠の山かけかたふきにけり",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "時鳥ひるねの夢のこゝちしてもりの梢を今そ過ぬる",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "かたらふも中〓〓也や子規たそかれときのあかぬ一こゑ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "二こゑと鳴てを過よ子規たそかれときはおほめかれけり",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "時鳥よはの一こゑきゝしよりやかてねかたき物をこそおもへ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "郭公ぬる程もなき夏のよをねさめよとてや鳴とよむらむ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "故里の人はまつらん狩にきてけふは野へにもくらしつる哉",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "あけくるゝ日數もしらて過にけりたゝ狩にとて出し野へにて",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "ころも打宿のとなりにすむ人はまとろむ事そ少なかりける",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あはれ今は峯のあらしにおとろきて衣うつなり遠の里人",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "朝な〓〓ぬく白玉とみゆる哉千草の露もぬれぬかきりは",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "花すゝきのきはにかゝる白露をやかてきえせぬ玉かとそみる",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "かりかねはくる秋ことに草枕旅のそらにそあかしわふなる",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ひきつらね旅の空なるかりかねは雲のうへにや宿はかるらむ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "おほつかな行ゑもみえす霧立ていかゝ尋ねん音なしのたき",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "秋霧のはれまもみえて山彥のことふるかたにわれはきにけり",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "白妙の雪にまかへる梅の花くれなゐな□いろはみえまし",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "ふりきらす雪にちりかふ梅の花きえぬをみては人はわくとも",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "春はなを柳の糸のたよりにや池のみきはに人もたえせぬ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "春のくる柳のいとやぬきつらん池のちりなみ玉にみゆれは",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
